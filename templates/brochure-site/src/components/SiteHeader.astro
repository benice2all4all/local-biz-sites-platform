---
const { businessName, phone, logoImage, logoImageAlt } = Astro.props;
---

<header>
  <div class="container">
    <nav>
      <a class="brand brand-with-logo" href="/">
        <img src={logoImage} alt={logoImageAlt} class="brand-logo" loading="eager" />
        <span>{businessName}</span>
      </a>
      <ul>
        <li><a href="/services">Services</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
      <a class="button nav-cta" href={`tel:${phone}`}>Call now</a>
    </nav>
  </div>
</header>
