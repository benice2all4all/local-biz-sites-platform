---
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/global.css';
import site from '../../site.json';

interface Props {
  title: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <style define:vars={{ primary: site.primaryColor, accent: site.accentColor }}>
      :root {
        --primary: var(--primary, #0f172a);
        --accent: var(--accent, #2563eb);
      }
    </style>
  </head>
  <body>
    <SiteHeader businessName={site.businessName} />
    <main>
      <slot />
    </main>
    <footer>
      <div class="container">
        <strong>{site.businessName}</strong><br />
        {site.cityState} · <a href={`tel:${site.phone}`}>{site.phone}</a> · <a href={`mailto:${site.email}`}>{site.email}</a>
      </div>
    </footer>
  </body>
</html>
