---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../../site.json';
---

<BaseLayout title={`About | ${site.businessName}`}>
  <section>
    <div class="container">
      <div class="eyebrow">About</div>
      <h1>Meet {site.businessName}</h1>
      <div class="card">
        <p>
          Tell the story of the business, the owner, the service area, and why customers trust you.
          Keep this page simple, direct, and local.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
